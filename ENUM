//ENUM INSERT
<?php
include 'koneksi.php';

// Cek apakah tombol submit ditekan
if (isset($_POST['tambah'])) {
    $nama_menu = $_POST['nama_menu'];
    $harga     = $_POST['harga'];
    $kategori  = $_POST['kategori']; // Jika ada kolom ENUM

    $query = "INSERT INTO menu (nama_menu, harga, kategori) VALUES ('$nama_menu', '$harga', '$kategori')";
    
    if (mysqli_query($conn, $query)) {
        // Redirect kembali ke halaman utama jika berhasil
        header("Location: index.php?status=sukses_tambah");
        exit;
    } else {
        echo "Gagal tambah data: " . mysqli_error($conn);
    }
}
